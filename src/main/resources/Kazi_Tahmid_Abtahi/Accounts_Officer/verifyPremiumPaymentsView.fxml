<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="510.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Kazi_Tahmid_Abtahi.AccountsOfficerControllers.verifyPremiumsController">
    <children>
        <Label layoutX="210.0" layoutY="28.0" text="Verify Premium Payments" textFill="#2b2091">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label layoutX="65.0" layoutY="75.0" text="Unverified Customer Premium Payments :" textFill="#200f7e">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <TableView fx:id="unverifiedPaymentsTableView" layoutX="65.0" layoutY="100.0" prefHeight="210.0" prefWidth="570.0">
            <columns>
                <TableColumn fx:id="customerIdTC" prefWidth="125.0" text="Customer ID" />
                <TableColumn fx:id="policyIdTC" prefWidth="125.0" text="Policy ID" />
                <TableColumn fx:id="bankReferenceNumberTC" prefWidth="180.0" text="Bank Reference Number" />
                <TableColumn fx:id="amountPaidTC" prefWidth="138.0" text="Amount Paid" />
            </columns>
        </TableView>

        <Label layoutX="65.0" layoutY="328.0" text="Payment Verification Action : " textFill="#242fac">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <Label layoutX="65.0" layoutY="358.0" text="Select Confirmation Status :" />
        <ComboBox fx:id="statusCB" layoutX="230.0" layoutY="354.0" prefWidth="160.0" />

        <Label layoutX="65.0" layoutY="396.0" text="Rejection Comment :" />
        <TextField fx:id="rejectionCommentTF" layoutX="195.0" layoutY="392.0" prefHeight="26.0" prefWidth="250.0" promptText="Required if status is Rejected" />

        <Button layoutX="460.0" layoutY="392.0" mnemonicParsing="false" onAction="#confirmVerificationButtonOnAction" text="Confirm &amp; Update Status" />

        <Label fx:id="statusMessageLabel" layoutX="65.0" layoutY="445.0" prefHeight="40.0" prefWidth="570.0" text="Status : Select a transaction row to verify." textFill="#00000b" />
    </children>
</AnchorPane>