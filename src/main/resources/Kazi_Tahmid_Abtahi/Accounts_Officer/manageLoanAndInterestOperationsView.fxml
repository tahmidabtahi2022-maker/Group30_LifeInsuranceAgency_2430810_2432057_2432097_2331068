<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="510.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Kazi_Tahmid_Abtahi.AccountsOfficerControllers.manageLoanAndOperationsController">
    <children>
        <Label layoutX="185.0" layoutY="28.0" text="Loan Operations &amp; Disbursements" textFill="#2b2091">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label layoutX="63.0" layoutY="87.0" text="Pending Customer Policy Loan Applications :" textFill="#200f7e">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <TableView fx:id="pendingLoansTableView" layoutX="65.0" layoutY="118.0" prefHeight="220.0" prefWidth="570.0">
            <columns>
                <TableColumn fx:id="loanAppIdTC" prefWidth="130.0" text="Loan App ID" />
                <TableColumn fx:id="policyIdTC" prefWidth="120.0" text="Policy ID" />
                <TableColumn fx:id="totalCashValueTC" prefWidth="160.0" text="Total Policy Cash Value" />
                <TableColumn fx:id="requestedAmountTC" prefWidth="158.0" text="Requested Loan Amount" />
            </columns>
        </TableView>

        <Button layoutX="63.0" layoutY="359.0" mnemonicParsing="false" onAction="#approveAndFundLoanButtonOnAction" text="Approve &amp; Fund Selected Loan" />

        <Label fx:id="statusMessageLabel" layoutX="65.0" layoutY="417.0" prefHeight="40.0" prefWidth="570.0" text="Status : " textFill="#00000b" />
    </children>
</AnchorPane>
