<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="589.0" prefWidth="722.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Kazi_Tahmid_Abtahi.AccountsOfficerControllers.financialTransactionLedgerController">
    <children>
        <Label layoutX="210.0" layoutY="28.0" text="Master Transaction Ledger" textFill="#2b2091">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label layoutX="65.0" layoutY="115.0" text="Search Policy ID :" />
        <TextField fx:id="searchPolicyIdTF" layoutX="170.0" layoutY="110.0" prefHeight="26.0" prefWidth="130.0" promptText="Enter Policy ID" />

        <Label layoutX="322.0" layoutY="115.0" text="Transaction Type :" />
        <ComboBox fx:id="transactionTypeCB" layoutX="427.0" layoutY="110.0" prefWidth="130.0" />

        <Button layoutX="70.0" layoutY="179.0" mnemonicParsing="false" onAction="#filterLedgerButtonOnAction" prefHeight="30.0" prefWidth="118.0" text="Filter Ledger" />

        <TableView fx:id="masterLedgerTableView" layoutX="65.0" layoutY="228.0" prefHeight="220.0" prefWidth="582.0">
            <columns>
                <TableColumn fx:id="transactionIdTC" prefWidth="100.0" text="Transaction ID" />
                <TableColumn fx:id="policyIdTC" prefWidth="100.0" text="Policy ID" />
                <TableColumn fx:id="transactionTypeTC" prefWidth="120.0" text="Transaction Type" />
                <TableColumn fx:id="amountTC" prefWidth="128.800048828125" text="Amount" />
                <TableColumn fx:id="transactionDateTC" prefWidth="132.00003662109373" text="Transaction Date" />
            </columns>
        </TableView>

        <Button layoutX="61.0" layoutY="471.0" mnemonicParsing="false" onAction="#exportStatementButtonOnAction" text="Export Statement Summary " />

        <Label fx:id="statusMessageLabel" layoutX="65.0" layoutY="497.0" prefHeight="40.0" prefWidth="570.0" text="Status : " textFill="#00000b" />
    </children>
</AnchorPane>
