<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="510.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Kazi_Tahmid_Abtahi.AccountsOfficerControllers.manageAgentCommissionsController">
    <children>
        <Label layoutX="180.0" layoutY="28.0" text="Calculate &amp; Disburse Agent Commissions" textFill="#2b2091">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label layoutX="49.0" layoutY="106.0" text="Select Agent ID :" />
        <ComboBox fx:id="agentIdCB" layoutX="144.0" layoutY="102.0" prefWidth="140.0" />

        <Label layoutX="49.0" layoutY="142.0" text="Start Date :" />
        <DatePicker fx:id="startDatePicker" layoutX="148.0" layoutY="138.0" prefWidth="130.0" />

        <Label layoutX="51.0" layoutY="177.0" text="End Date :" />
        <DatePicker fx:id="endDatePicker" layoutX="148.0" layoutY="173.0" prefWidth="130.0" />

        <Button layoutX="350.0" layoutY="172.0" mnemonicParsing="false" onAction="#loadPoliciesAndCalculateButtonOnAction" prefHeight="26.0" prefWidth="223.0" text="Load Policies And Calculate" />

        <TableView fx:id="agentCommissionsTableView" layoutX="42.0" layoutY="223.0" prefHeight="180.0" prefWidth="608.0">
            <columns>
                <TableColumn fx:id="policyIdTC" prefWidth="100.0" text="Policy ID" />
                <TableColumn fx:id="policyTypeTC" prefWidth="110.0" text="Policy Type" />
                <TableColumn fx:id="premiumCollectedTC" prefWidth="128.79998779296875" text="Premium Collected" />
                <TableColumn fx:id="commissionRateTC" prefWidth="119.20001220703125" text="Commission Rate" />
                <TableColumn fx:id="calculatedCommissionTC" prefWidth="149.60000610351562" text="Calculated Commission" />
            </columns>
        </TableView>

        <Label layoutX="65.0" layoutY="417.0" text="Total Payable Commission : " />

        <Label fx:id="totalCommissionLabel" layoutX="232.0" layoutY="417.0" text="0.00 BDT" />

        <Button layoutX="350.0" layoutY="413.0" mnemonicParsing="false" onAction="#processCommissionPayoutButtonOnAction" prefHeight="30.0" prefWidth="178.0" text="Process Commission Payout" />

        <Label fx:id="statusMessageLabel" layoutX="65.0" layoutY="443.0" prefHeight="40.0" prefWidth="570.0" text="Status : " textFill="#00000b" />
    </children>
</AnchorPane>
