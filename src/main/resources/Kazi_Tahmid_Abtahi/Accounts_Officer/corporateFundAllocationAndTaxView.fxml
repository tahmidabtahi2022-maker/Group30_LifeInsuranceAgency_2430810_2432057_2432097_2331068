<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="510.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Kazi_Tahmid_Abtahi.AccountsOfficerControllers.corporateFundAllocationAndTaxController">
    <children>
        <Label layoutX="140.0" layoutY="28.0" text="Corporate Fund Allocation &amp; Tax Provisions" textFill="#2b2091">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label layoutX="60.0" layoutY="102.0" text="Configure Fund Allocation : " textFill="#200f7e">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <Label layoutX="63.0" layoutY="133.0" text="Emergency Payout Reserves (%) :" />
        <TextField fx:id="emergencyPayoutReservesTF" layoutX="260.0" layoutY="128.0" prefHeight="26.0" prefWidth="180.0" />

        <Label layoutX="63.0" layoutY="169.0" text="Operational Expenses (%) :" />
        <TextField fx:id="operationalExpensesTF" layoutX="260.0" layoutY="164.0" prefHeight="26.0" prefWidth="180.0" />

        <Label layoutX="63.0" layoutY="209.0" text="Tax Provisions (%) :" />
        <TextField fx:id="taxProvisionsTF" layoutX="260.0" layoutY="204.0" prefHeight="26.0" prefWidth="180.0" />

        <Button layoutX="66.0" layoutY="242.0" mnemonicParsing="false" onAction="#saveAndReallocateFundsButtonOnAction" text="Save &amp; Reallocate Funds" />

        <Label layoutX="65.0" layoutY="290.0" text="Current Allocation Summary : " textFill="#242fac">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <Label layoutX="68.0" layoutY="320.0" text="Total Emergency Reserve Balance :" />
        <Label fx:id="emergencyReserveBalanceLabel" layoutX="280.0" layoutY="320.0" text="0.00 BDT" />

        <Label layoutX="67.0" layoutY="350.0" text="Total Operational Expense Balance :" />
        <Label fx:id="operationalExpenseBalanceLabel" layoutX="280.0" layoutY="350.0" text="0.00 BDT" />

        <Label layoutX="67.0" layoutY="380.0" text="Total Tax Provision Balance :" />
        <Label fx:id="taxProvisionBalanceLabel" layoutX="280.0" layoutY="380.0" text="0.00 BDT" />

        <Label fx:id="statusMessageLabel" layoutX="68.0" layoutY="430.0" prefHeight="40.0" prefWidth="570.0" text="Status : " textFill="#00000b" />
    </children>
</AnchorPane>
