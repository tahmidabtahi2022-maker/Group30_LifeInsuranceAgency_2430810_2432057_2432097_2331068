<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="652.0" prefWidth="754.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Kazi_Tahmid_Abtahi.CustomerControllers.claimsAndSurrenderTrackingController">
    <children>
        <Label layoutX="210.0" layoutY="28.0" text="Claims &amp; Surrender Tracking" textFill="#2b2091">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label layoutX="70.0" layoutY="85.0" text="Select Claim / Policy ID :" />
        <ComboBox fx:id="claimSelectCB" layoutX="225.0" layoutY="81.0" prefWidth="180.0" />
        <Button layoutX="420.0" layoutY="81.0" mnemonicParsing="false" onAction="#loadClaimDetailsButtonOnAction" text="Load Claim Details" />

        <Label layoutX="70.0" layoutY="125.0" text="Claim Progress Timeline : " textFill="#200f7e">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <Label layoutX="69.0" layoutY="151.0" text="Claim Request Submitted :" />
        <Label fx:id="claimRequestSubmittedStatusLabel" layoutX="245.0" layoutY="150.0" text="None" />

        <Label layoutX="70.0" layoutY="179.0" text="Policy Integrity Validation :" />
        <Label fx:id="policyIntegrityValidationStatusLabel" layoutX="245.0" layoutY="177.0" text="None" />

        <Label layoutX="70.0" layoutY="206.0" text="Document Verification Status :" />
        <Label fx:id="documentVerificationStatusLabel" layoutX="245.0" layoutY="204.0" text="None" />

        <Label layoutX="70.0" layoutY="232.0" text="Finance Approval :" />
        <Label fx:id="financeApprovalStatusLabel" layoutX="245.0" layoutY="232.0" text="None" />

        <Label layoutX="71.0" layoutY="260.0" text="Pay out Process Progress :" />
        <Label fx:id="payOutProcessProgressStatusLabel" layoutX="245.0" layoutY="260.0" text="None" />

        <Label layoutX="69.0" layoutY="317.0" text="Past Payout Records &amp; History : " textFill="#242fac">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <TableView fx:id="pastPayoutsTableView" layoutX="71.0" layoutY="348.0" prefHeight="188.0" prefWidth="636.0">
            <columns>
                <TableColumn fx:id="claimIdTC" prefWidth="104.79998779296875" text="Claim ID" />
                <TableColumn fx:id="policyTypeTC" prefWidth="103.19999694824219" text="Policy Type" />
                <TableColumn fx:id="claimTypeTC" prefWidth="104.800048828125" text="Claim Type" />
                <TableColumn fx:id="payoutAmountTC" prefWidth="123.20001220703125" text="Payout Amount" />
                <TableColumn fx:id="payoutDateTC" prefWidth="108.79998779296875" text="Payout Date" />
                <TableColumn fx:id="statusTC" prefWidth="91.99993896484375" text="Status" />
            </columns>
        </TableView>

        <Button layoutX="76.0" layoutY="550.0" mnemonicParsing="false" onAction="#downloadClaimHistorySummaryButtonOnAction" text="Download Claim History " />

        <Label fx:id="statusMessageLabel" layoutX="76.0" layoutY="584.0" prefHeight="40.0" prefWidth="560.0" text="Status : " textFill="#00000b" />
    </children>
</AnchorPane>
