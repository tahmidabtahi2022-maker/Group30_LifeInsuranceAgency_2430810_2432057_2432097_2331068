<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Kazi_Tahmid_Abtahi.CustomerControllers.policyLoanAndAPLController">
    <children>
        <Label layoutX="225.0" layoutY="28.0" text="Policy Loans &amp; Settings" textFill="#2b2091">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label layoutX="70.0" layoutY="93.0" text="Select Policy ID :" />
        <ComboBox fx:id="policySelectCB" layoutX="190.0" layoutY="89.0" prefWidth="180.0" />

        <Label layoutX="70.0" layoutY="133.0" text="Policy Loan Details : " textFill="#200f7e">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <Label layoutX="71.0" layoutY="157.0" text="Total Accumulated Cash Value :" />
        <Label fx:id="accumulatedCashValueLabel" layoutX="279.0" layoutY="157.0" text="0.00 BDT" />

        <Label layoutX="71.0" layoutY="187.0" text="Max Available Loan Limit (80%) :" />
        <Label fx:id="maxLoanLimitLabel" layoutX="279.0" layoutY="187.0" text="0.00 BDT" />

        <Label graphicTextGap="2.0" layoutX="70.0" layoutY="215.0" text="Current APL Status :" />
        <Label fx:id="currentAplStatusLabel" layoutX="280.0" layoutY="215.0" text="Disabled" />

        <Label layoutX="70.0" layoutY="260.0" text="Apply for Policy Loan : " textFill="#242fac">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <Label layoutX="70.0" layoutY="295.0" text="Requested Loan Amount :" />
        <TextField fx:id="requestedLoanAmountTF" layoutX="250.0" layoutY="291.0" prefHeight="26.0" prefWidth="180.0" />
        <CheckBox fx:id="aplStatusCheckBox" layoutX="74.0" layoutY="334.0" mnemonicParsing="false" text="Enable Automatic Premium Loan (APL) " />

        <Label fx:id="statusMessageLabel" layoutX="74.0" layoutY="391.0" prefHeight="54.0" prefWidth="371.0" text="Status : " textFill="#00000b" />
      <Button layoutX="430.0" layoutY="89.0" mnemonicParsing="false" onAction="#loadPolicyDetailsButtonOnAction" text="Load Policy Details" />
      <Button layoutX="469.0" layoutY="291.0" mnemonicParsing="false" onAction="#applyForLoanButtonOnAction" text="Apply Loan" />
      <Button layoutX="326.0" layoutY="330.0" mnemonicParsing="false" onAction="#updateAplStatusButtonOnAction" text="Update APL Setting" />
    </children>
</AnchorPane>
