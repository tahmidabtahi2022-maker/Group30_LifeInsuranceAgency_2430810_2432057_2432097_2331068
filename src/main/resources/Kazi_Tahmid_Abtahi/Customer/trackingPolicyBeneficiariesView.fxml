<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="710.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Kazi_Tahmid_Abtahi.CustomerControllers.trackingPolicyBeneficiariesController">
    <children>
        <Label layoutX="247.0" layoutY="27.0" text="My Policy Beneficiaries" textFill="#251889">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <TableView fx:id="policybeneficiariesTableview" layoutX="56.0" layoutY="121.0" prefHeight="200.0" prefWidth="569.0">
            <columns>
                <TableColumn fx:id="policyIdTC" prefWidth="85.0" text="Policy Id" />
                <TableColumn fx:id="policyTypeTC" prefWidth="105.0" text="Policy Type" />
                <TableColumn fx:id="beneficiaryNameTC" prefWidth="125.0" text="Beneficiary Name" />
                <TableColumn fx:id="legalRelationshipTC" prefWidth="120.0" text="Legal Relationship" />
                <TableColumn fx:id="allocationPercentageTC" prefWidth="132.0" text="Allocation (%)" />
            </columns>
        </TableView>
        <Label layoutX="59.0" layoutY="332.0" text="Add / Update Policy Beneficiaries Information : " textFill="#161681">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <Label layoutX="60.0" layoutY="367.0" text="Enter policy id to assign/update : " />
        <TextField fx:id="policyIdUpdateTF" layoutX="261.0" layoutY="363.0" prefWidth="160.0" />
        <Label layoutX="59.0" layoutY="401.0" text="Beneficiary Name : " />
        <TextField fx:id="updateBeneficiaryNameInputTF" layoutX="261.0" layoutY="397.0" prefWidth="160.0" />
        <Label layoutX="60.0" layoutY="431.0" text="Beneficiary Relationship:" />
        <TextField fx:id="updateBeneficiaryRelationshipInputTF" layoutX="261.0" layoutY="427.0" prefWidth="160.0" />
        <Label layoutX="60.0" layoutY="465.0" text="Allocation Percentage (%) : " />
        <TextField fx:id="updateAllocationPercentageInputTF" layoutX="261.0" layoutY="461.0" prefWidth="160.0" />
        <Button layoutX="442.0" layoutY="406.0" mnemonicParsing="false" onAction="#addBeneficiaryToListButtonOnAction" prefHeight="26.0" prefWidth="178.0" text="Add Beneficiary to List" />
        <Button layoutX="442.0" layoutY="452.0" mnemonicParsing="false" onAction="#saveBeneficiaryInformationsButtonOnActionS" prefHeight="26.0" prefWidth="178.0" text="Save Beneficiary Informations" />
        <Label fx:id="updateInformationStatusLabel" layoutX="60.0" layoutY="495.0" prefHeight="40.0" prefWidth="582.0" text="Status : " wrapText="true">
            <font>
                <Font size="11.0" />
            </font>
        </Label>
      <Button layoutX="60.0" layoutY="81.0" mnemonicParsing="false" onAction="#loadPolicyBeneficiaryInformationsButtonOnAction" prefHeight="26.0" prefWidth="224.0" text="Load Policy Beneficiary  Informations" />
    </children>
</AnchorPane>
