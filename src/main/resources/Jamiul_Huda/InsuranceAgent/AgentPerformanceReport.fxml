<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="896.0"
      prefWidth="1231.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Jamiul_Huda.InsuranceAgentControllers.AgentPerformanceReportController">

    <children>

        <Label fx:id="lblTitle"
               alignment="CENTER"
               prefHeight="76.0"
               prefWidth="1231.0"
               style="-fx-background-color: #fffcc5;"
               text="Performance Analytics &amp; Commission Statement Tool">
            <font>
                <Font name="Carlito Bold" size="24.0"/>
            </font>
        </Label>

        <HBox fx:id="dateBox"
              prefHeight="42.0"
              prefWidth="1231.0">

            <children>

                <Label fx:id="lblFrom"
                       alignment="CENTER"
                       prefHeight="35.0"
                       prefWidth="52.0"
                       text="From">
                    <font>
                        <Font name="Carlito Bold" size="14.0"/>
                    </font>
                </Label>

                <DatePicker fx:id="dpFrom"
                            prefHeight="34.0"
                            prefWidth="152.0"/>

                <Label fx:id="lblTo"
                       alignment="CENTER"
                       prefHeight="34.0"
                       prefWidth="28.0"
                       text="To">
                    <font>
                        <Font name="Carlito Bold" size="14.0"/>
                    </font>
                </Label>

                <DatePicker fx:id="dpTo"
                            prefHeight="33.0"
                            prefWidth="152.0"/>

            </children>

        </HBox>

        <Button fx:id="btnGenerateReport"
                mnemonicParsing="false"
                prefHeight="40.0"
                prefWidth="385.0"
                style="-fx-background-color: #ffd2d2;"
                text="Generate Report">
            <font>
                <Font name="Carlito Bold" size="14.0"/>
            </font>
        </Button>

        <Label fx:id="lblSummary"
               alignment="CENTER"
               prefHeight="41.0"
               prefWidth="1231.0"
               style="-fx-background-color: #c6ffce;"
               text="Performance Summary">
            <font>
                <Font name="Carlito Bold" size="18.0"/>
            </font>
        </Label>

        <TextArea fx:id="txtSummary"
                  prefHeight="200.0"
                  prefWidth="1231.0"/>

        <Label fx:id="lblGraph"
               alignment="CENTER"
               prefHeight="41.0"
               prefWidth="1231.0"
               style="-fx-background-color: #c6ffce;"
               text="Performance Graph">
            <font>
                <Font name="Carlito Bold" size="18.0"/>
            </font>
        </Label>

        <TextArea fx:id="txtGraph"
                  prefHeight="150.0"
                  prefWidth="1231.0"
                  text="Performance graph will be displayed here.">
            <font>
                <Font name="Carlito Bold" size="14.0"/>
            </font>
        </TextArea>

    </children>

</VBox>