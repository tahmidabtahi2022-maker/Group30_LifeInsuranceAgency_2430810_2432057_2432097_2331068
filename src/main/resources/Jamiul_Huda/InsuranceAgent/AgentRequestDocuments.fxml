<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="897.0"
      prefWidth="1277.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Jamiul_Huda.InsuranceAgentControllers.AgentRequestDocumentsController">

    <children>

        <Label fx:id="lblTitle"
               alignment="CENTER"
               prefHeight="59.0"
               prefWidth="1418.0"
               style="-fx-background-color: #b3f876;"
               text="Client Clarification &amp; Evidence Requests Manager">
            <font>
                <Font name="Carlito Bold" size="24.0"/>
            </font>
        </Label>

        <HBox fx:id="applicationIdBox"
              prefHeight="28.0"
              prefWidth="1277.0">
            <children>

                <Label fx:id="lblApplicationId"
                       prefHeight="18.0"
                       prefWidth="107.0"
                       text="Application ID:">
                    <font>
                        <Font name="Carlito Bold" size="14.0"/>
                    </font>
                </Label>

                <TextField fx:id="txtApplicationId"/>

            </children>
        </HBox>

        <Label fx:id="lblMissingDocuments"
               prefHeight="30.0"
               prefWidth="133.0"
               text="Missing Documents">
            <font>
                <Font name="Carlito Bold" size="14.0"/>
            </font>
        </Label>

        <CheckBox fx:id="chkSalarySlip"
                  mnemonicParsing="false"
                  prefHeight="32.0"
                  prefWidth="194.0"
                  text="Latest Salary Slip Statement">
            <font>
                <Font name="Carlito Bold" size="14.0"/>
            </font>
        </CheckBox>

        <CheckBox fx:id="chkPhysicianLetter"
                  mnemonicParsing="false"
                  prefHeight="32.0"
                  prefWidth="257.0"
                  text="Attending Physician Clarification Letter">
            <font>
                <Font name="Carlito Bold" size="14.0"/>
            </font>
        </CheckBox>

        <Label fx:id="lblReason"
               prefHeight="46.0"
               prefWidth="155.0"
               text="Reason for Request">
            <font>
                <Font name="Carlito Bold" size="14.0"/>
            </font>
        </Label>

        <TextArea fx:id="txtReason"
                  prefHeight="200.0"
                  prefWidth="200.0"
                  style="-fx-background-color: #ff1508;"/>

        <Button fx:id="btnSendRequest"
                defaultButton="true"
                mnemonicParsing="false"
                prefHeight="47.0"
                prefWidth="181.0"
                text="Send Request">
            <font>
                <Font name="Carlito Bold" size="14.0"/>
            </font>
        </Button>

        <Label fx:id="lblStatus"
               alignment="CENTER"
               contentDisplay="CENTER"
               prefHeight="78.0"
               prefWidth="1277.0"
               style="-fx-background-color: #ffa8e6;"
               text="Document Requirement Alert Dispatched">
            <font>
                <Font name="Carlito Bold" size="18.0"/>
            </font>
        </Label>

    </children>

</VBox>