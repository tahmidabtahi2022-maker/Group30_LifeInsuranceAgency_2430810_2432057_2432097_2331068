<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Jamiul_Huda.InsuranceAgentControllers.CreateCustomerProfileController"
            prefWidth="1300"
            prefHeight="850"
            style="-fx-background-color:#F5F7FA;">


    <!-- TOP HEADER -->

    <top>

        <HBox alignment="CENTER_LEFT"
              prefHeight="80"
              spacing="20"
              style="-fx-background-color:#1565C0;">

            <padding>
                <Insets left="30" right="30"/>
            </padding>


            <children>

                <Label text="Insurance Agent Dashboard"
                       fx:id="dashboardTitleLabel"
                       textFill="WHITE">

                    <font>
                        <Font size="26"/>
                    </font>

                </Label>


                <Pane HBox.hgrow="ALWAYS"/>


                <Label fx:id="agentNameLabel"
                       text="Insurance Agent"
                       textFill="WHITE">

                    <font>
                        <Font size="18"/>
                    </font>

                </Label>


            </children>


        </HBox>

    </top>



    <!-- CENTER FORM -->


    <center>


        <VBox alignment="CENTER"
              spacing="20">


            <padding>
                <Insets top="30"
                        right="60"
                        bottom="30"
                        left="60"/>
            </padding>



            <children>


                <VBox prefWidth="800"
                      spacing="25"
                      style="-fx-background-color:white;
                             -fx-background-radius:15;
                             -fx-padding:35;">


                    <children>


                        <Label text="Create Customer Profile"
                               alignment="CENTER"
                               maxWidth="Infinity"
                               style="-fx-background-color:#90CAF9;
                                      -fx-background-radius:10;">


                            <font>
                                <Font size="26"/>
                            </font>


                        </Label>



                        <GridPane hgap="20"
                                  vgap="20">


                            <columnConstraints>

                                <ColumnConstraints prefWidth="220"/>

                                <ColumnConstraints hgrow="ALWAYS"/>

                            </columnConstraints>



                            <children>


                                <Label text="Full Name"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="0"/>


                                <TextField fx:id="fullNameTextField"
                                           promptText="Enter Customer Name"
                                           GridPane.rowIndex="0"
                                           GridPane.columnIndex="1"/>



                                <Label text="National ID"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="0"/>


                                <TextField fx:id="nidTextField"
                                           promptText="Enter NID Number"
                                           GridPane.rowIndex="1"
                                           GridPane.columnIndex="1"/>



                                <Label text="Mobile Number"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="0"/>


                                <TextField fx:id="mobileNumberTextField"
                                           promptText="01XXXXXXXXX"
                                           GridPane.rowIndex="2"
                                           GridPane.columnIndex="1"/>



                                <Label text="Email Address"
                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="0"/>


                                <TextField fx:id="emailTextField"
                                           promptText="example@email.com"
                                           GridPane.rowIndex="3"
                                           GridPane.columnIndex="1"/>



                                <Label text="Date Of Birth"
                                       GridPane.rowIndex="4"
                                       GridPane.columnIndex="0"/>


                                <DatePicker fx:id="dateOfBirthPicker"
                                            GridPane.rowIndex="4"
                                            GridPane.columnIndex="1"/>


                            </children>


                        </GridPane>



                        <HBox alignment="CENTER"
                              spacing="25">


                            <children>


                                <Button fx:id="createProfileButton"
                                        text="Create Profile"
                                        prefWidth="220"
                                        prefHeight="45"
                                        style="-fx-background-color:#4CAF50;
                                               -fx-text-fill:white;
                                               -fx-font-size:16;"
                                        onAction="#createProfile"/>



                                <Button fx:id="clearButton"
                                        text="Clear"
                                        prefWidth="220"
                                        prefHeight="45"
                                        style="-fx-background-color:#FFC107;
                                               -fx-font-size:16;"
                                        onAction="#clearForm"/>


                            </children>


                        </HBox>


                    </children>


                </VBox>


            </children>


        </VBox>


    </center>




    <!-- BOTTOM NAVIGATION -->


    <bottom>


        <VBox spacing="8">


            <children>


                <Label fx:id="statusLabel"
                       text="Ready to Create Customer"
                       alignment="CENTER"
                       prefHeight="40"
                       style="-fx-background-color:#CFD8DC;
                              -fx-font-size:16;
                              -fx-font-weight:bold;"/>



                <HBox alignment="CENTER"
                      spacing="30"
                      prefHeight="70"
                      style="-fx-background-color:#ECEFF1;">


                    <children>


                        <Button fx:id="dashboardButton"
                                text="Dashboard"
                                prefWidth="180"
                                prefHeight="45"
                                style="-fx-background-color:#2196F3;
                                       -fx-text-fill:white;"
                                onAction="#openDashboard"/>



                        <Button fx:id="backButton"
                                text="Back"
                                prefWidth="180"
                                prefHeight="45"
                                style="-fx-background-color:#FF9800;
                                       -fx-text-fill:white;"
                                onAction="#back"/>



                        <Button fx:id="logoutButton"
                                text="Logout"
                                prefWidth="180"
                                prefHeight="45"
                                style="-fx-background-color:#F44336;
                                       -fx-text-fill:white;"
                                onAction="#logout"/>


                    </children>


                </HBox>


            </children>


        </VBox>


    </bottom>


</BorderPane>