<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="909.0"
            prefWidth="1278.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Jamiul_Huda.InsuranceAgentControllers.ClientVerificationAuditFeedController">

    <top>
        <Label alignment="CENTER"
               prefHeight="60"
               prefWidth="1278"
               text="Client Verification Audit Feed"
               style="-fx-background-color:#bcf9ff;"
               BorderPane.alignment="CENTER">
            <font>
                <Font size="24"/>
            </font>
        </Label>
    </top>

    <center>

        <VBox spacing="15" prefWidth="1278">

            <children>

                <HBox spacing="10">

                    <children>

                        <Label text="Client ID" prefWidth="100"/>

                        <TextField fx:id="clientIdTextField"
                                   prefWidth="200"/>

                        <Button fx:id="searchButton"
                                text="Search"
                                onAction="#searchClient"/>

                    </children>

                </HBox>

                <TableView fx:id="documentTableView"
                           prefHeight="350"
                           prefWidth="1200">

                    <columns>

                        <TableColumn fx:id="clientIdColumn"
                                     text="Client ID"
                                     prefWidth="250"/>

                        <TableColumn fx:id="customerNameColumn"
                                     text="Customer Name"
                                     prefWidth="250"/>

                        <TableColumn fx:id="documentTypeColumn"
                                     text="Document Type"
                                     prefWidth="300"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="300"/>

                    </columns>

                </TableView>

                <HBox spacing="30">

                    <children>

                        <ImageView fx:id="nidImageView"
                                   fitHeight="180"
                                   fitWidth="250"
                                   preserveRatio="true"/>

                        <ImageView fx:id="medicalReportImageView"
                                   fitHeight="180"
                                   fitWidth="250"
                                   preserveRatio="true"/>

                    </children>

                </HBox>

                <HBox spacing="20">

                    <children>

                        <Button fx:id="approveKYCButton"
                                text="Approve KYC"
                                prefWidth="220"
                                onAction="#approveKYC">

                            <font>
                                <Font size="18"/>
                            </font>

                        </Button>

                        <Button fx:id="markDeficientButton"
                                text="Mark Deficient"
                                prefWidth="220"
                                onAction="#markDeficient">

                            <font>
                                <Font size="18"/>
                            </font>

                        </Button>

                        <Button fx:id="refreshButton"
                                text="Refresh"
                                prefWidth="220"
                                onAction="#refreshTable">

                            <font>
                                <Font size="18"/>
                            </font>

                        </Button>

                    </children>

                </HBox>

            </children>

        </VBox>

    </center>

    <bottom>

        <Label fx:id="notificationLabel"
               alignment="CENTER"
               prefHeight="70"
               text="Waiting for Verification"
               style="-fx-background-color:#87ffc9;"
               BorderPane.alignment="CENTER">

            <font>
                <Font size="20"/>
            </font>

        </Label>

    </bottom>

</BorderPane>