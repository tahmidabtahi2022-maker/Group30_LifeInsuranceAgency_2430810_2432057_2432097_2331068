<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Jamiul_Huda.InsuranceAgentControllers.ReviewTrackerController"
            prefWidth="1310.0"
            prefHeight="885.0">

    <top>
        <Label alignment="CENTER"
               text="Underwriter Review Pipeline Tracker"
               prefHeight="65.0"
               style="-fx-background-color:#ffc2e5;"
               BorderPane.alignment="CENTER">

            <font>
                <Font name="Arial Bold" size="24"/>
            </font>

        </Label>
    </top>

    <center>

        <VBox spacing="12" BorderPane.alignment="CENTER">

            <HBox spacing="10">

                <Label text="Application ID :" prefWidth="120"/>

                <TextField fx:id="applicationIdTextField"
                           prefWidth="180"/>

                <Button fx:id="searchButton"
                        text="Search"
                        onAction="#search"/>

            </HBox>

            <TableView fx:id="reviewTableView"
                       prefHeight="350">

                <columns>

                    <TableColumn fx:id="applicationIdColumn"
                                 text="Application ID"
                                 prefWidth="220"/>

                    <TableColumn fx:id="customerNameColumn"
                                 text="Customer Name"
                                 prefWidth="240"/>

                    <TableColumn fx:id="submissionDateColumn"
                                 text="Submission Date"
                                 prefWidth="220"/>

                    <TableColumn fx:id="currentStatusColumn"
                                 text="Current Status"
                                 prefWidth="280"/>

                    <TableColumn fx:id="underwriterNotesColumn"
                                 text="Underwriter Notes"
                                 prefWidth="320"/>

                </columns>

            </TableView>

            <HBox spacing="10">

                <Label text="Selected Status"
                       prefWidth="140"/>

                <TextField fx:id="selectedStatusTextField"
                           editable="false"
                           prefWidth="300"/>

            </HBox>

            <HBox spacing="15">

                <Button fx:id="refreshButton"
                        text="Refresh"
                        prefWidth="250"
                        style="-fx-background-color:#b0eaff;"
                        onAction="#refresh">

                    <font>
                        <Font name="Arial Bold" size="18"/>
                    </font>

                </Button>

                <Button fx:id="clearButton"
                        text="Clear"
                        prefWidth="250"
                        style="-fx-background-color:#b0eaff;"
                        onAction="#clear">

                    <font>
                        <Font name="Arial Bold" size="18"/>
                    </font>

                </Button>

            </HBox>

        </VBox>

    </center>

    <bottom>

        <Label fx:id="notificationLabel"
               alignment="CENTER"
               text="Ready"
               prefHeight="60"
               style="-fx-background-color:#ee8888;"
               BorderPane.alignment="CENTER">

            <font>
                <Font name="Arial Bold" size="18"/>
            </font>

        </Label>

    </bottom>

</BorderPane>