<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="606.0" prefWidth="909.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Jamiul_Huda.InsuranceAgentControllers.ReviewTrackerController">

    <top>
        <Label alignment="CENTER" prefHeight="52.0" prefWidth="417.0" style="-fx-background-color:#ffc2e5;" text="Underwriter Review Pipeline Tracker" BorderPane.alignment="CENTER">

            <font>
                <Font name="Arial Bold" size="24" />
            </font>

        </Label>
    </top>

    <center>

        <VBox spacing="12" BorderPane.alignment="CENTER">

            <HBox spacing="10">

                <Label prefWidth="120" text="Application ID :" />

                <TextField fx:id="applicationIdTextField" prefWidth="180" />

                <Button fx:id="searchButton" onAction="#search" text="Search" />

            </HBox>

            <TableView fx:id="reviewTableView" prefHeight="350" prefWidth="840.0">

                <columns>

                    <TableColumn fx:id="applicationIdColumn" prefWidth="220" text="Application ID" />

                    <TableColumn fx:id="customerNameColumn" prefWidth="240" text="Customer Name" />

                    <TableColumn fx:id="submissionDateColumn" prefWidth="220" text="Submission Date" />

                    <TableColumn fx:id="currentStatusColumn" prefWidth="280" text="Current Status" />

                    <TableColumn fx:id="underwriterNotesColumn" prefWidth="320" text="Underwriter Notes" />

                </columns>

            </TableView>

            <HBox spacing="10">

                <Label prefWidth="140" text="Selected Status" />

                <TextField fx:id="selectedStatusTextField" editable="false" prefWidth="300" />

            </HBox>

            <HBox spacing="15">

                <Button fx:id="refreshButton" onAction="#refresh" prefWidth="250" style="-fx-background-color:#b0eaff;" text="Refresh">

                    <font>
                        <Font name="Arial Bold" size="18" />
                    </font>

                </Button>

                <Button fx:id="clearButton" onAction="#clear" prefWidth="250" style="-fx-background-color:#b0eaff;" text="Clear">

                    <font>
                        <Font name="Arial Bold" size="18" />
                    </font>

                </Button>

            </HBox>

        </VBox>

    </center>

    <bottom>

        <Label fx:id="notificationLabel" alignment="CENTER" prefHeight="60" prefWidth="92.0" style="-fx-background-color:#ee8888;" text="Ready" BorderPane.alignment="CENTER">

            <font>
                <Font name="Arial Bold" size="18" />
            </font>

        </Label>

    </bottom>

</BorderPane>
