<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane"
            maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="400.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Nashua_Haque.Branch_Manager.BranchManagerController">

    <top>
        <Label text="Branch Manager" BorderPane.alignment="CENTER">
            <font>
                <Font size="25.0"/>
            </font>
        </Label>
    </top>

    <left>
        <VBox alignment="TOP_CENTER" prefHeight="364.0" prefWidth="203.0" spacing="10.0">
            <children>
                <Label text="Menu">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>

                <Button text="View All Agents" onAction="#viewAllAgentsBOA"/>
                <Button text="Monitor Sales Performance" onAction="#monitorSalesPerformanceBOA"/>
                <Button text="Approve Agent Requests" onAction="#approveAgentRequestsBOA"/>
                <Button text="Assign Customers To Agents" onAction="#assignCustomersBOA"/>
                <Button text="View Branch Statistics" onAction="#viewBranchStatisticsBOA"/>
                <Button text="Generate Management Reports" onAction="#generateManagementReportsBOA"/>
                <Button text="Customer Satisfaction Data" onAction="#customerSatisfactionDataBOA"/>
                <Button text="Set Sales Target" onAction="#setSalesTargetBOA"/>
            </children>

            <padding>
                <Insets top="10" right="5" bottom="5" left="5"/>
            </padding>
        </VBox>
    </left>

    <center>
        <AnchorPane prefHeight="200.0" prefWidth="200.0"/>
    </center>

</BorderPane>